# AirborneDiag 本地配置示例。
#
# 复制为工程根目录下的 .env 后按实际部署修改。.env 已被 .gitignore 排除，
# 不要提交真实凭据；本示例文件会被提交，不要在这里填写真实值。
#
# 取值优先级：命令行参数 > 环境变量 > .env 文件 > 内置默认值。
# 默认值取自 RDC300I 上已验证可用的历史调用脚本。

# MindIE 服务地址，主机与端口，不含接口路径。
AIRBORNEDIAG_LLM_BASE_URL=http://127.0.0.1:1025

# MindIE 文本生成接口路径。当前实现的是 /generate 的请求与响应格式，
# 指向 OpenAI 兼容接口（/v1/chat/completions）不会工作，两者协议不同。
AIRBORNEDIAG_LLM_GENERATE_PATH=/generate

# 模型名，须与 MindIE 服务 config.json 中的 modelName 一致。
AIRBORNEDIAG_LLM_MODEL=Qwen2.5-1.5B

# 单次请求最大生成 token 数。
AIRBORNEDIAG_LLM_MAX_TOKENS=1000

# 单次请求超时秒数。历史脚本使用 300，服务冷启动或首次推理可能较慢。
AIRBORNEDIAG_LLM_TIMEOUT=300

# 服务需要认证时填写，非空则发送 Authorization: Bearer <值>。
# 留空表示不发送认证头。现有历史脚本未使用认证，板端是否需要待确认。
AIRBORNEDIAG_LLM_API_KEY=
